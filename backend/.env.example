# PostgreSQL
DATABASE_URL=postgresql://agervest:agervest@localhost:5432/agervest
PGHOST=localhost
PGPORT=5432
PGUSER=agervest
PGPASSWORD=agervest
PGDATABASE=agervest

# Server
PORT=3000
NODE_ENV=development

# JWT / sesiones (cambiar en producción)
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_NAME=agv_session

# CORS (coma separada)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Bcrypt
BCRYPT_ROUNDS=10
